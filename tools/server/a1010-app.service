# /etc/systemd/system/a1010-app.service — сайт a1010.ru (Node за nginx)
[Unit]
Description=CallAudit1010 (a1010.ru)
After=network-online.target
Wants=network-online.target

[Service]
User=a1010
WorkingDirectory=/opt/a1010/app
Environment=HOST=127.0.0.1
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/opt/a1010/.env scripts/dev-server.js 3000
Restart=always
RestartSec=2
MemoryMax=700M

[Install]
WantedBy=multi-user.target
