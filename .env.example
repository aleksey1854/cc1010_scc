# Подключение к Postgres (Neon: строка с ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kc1010?sslmode=require

# Размер пула соединений. На serverless держим узким.
PG_POOL_MAX=5

# --- только для тестов сверки со старым проектом на Apps Script ---
# Путь к харнессу старого проекта (test/harness.js). Без него сверка пропускается.
# LEGACY_HARNESS=../qc/test/harness
# Выгрузки листов для сверки.
# FROM_XLSX_JSON=./from_xlsx.json
# DUMP_JSON=./dump.json
# GENERATED_JSON=./generated.json
